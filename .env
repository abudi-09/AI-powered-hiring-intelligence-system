# Backend configuration
# NOTE: Do not commit real secrets. Replace placeholder values locally.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hiring_db

# Auth / JWT
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage
RESUME_STORAGE_PATH=./storage/resumes

# Runtime environment: development | production
APP_ENV=development
